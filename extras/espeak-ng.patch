+static int LookupNum3(Translator *tr, int value, char *ph_out, bool suppress_null, int thousandplex, int control)
+{
+	// Pronouncing a number can trigger another dictionary translation.
+	enum { MAX_ACTIVE_NUMBERS = 3 };
+	static NumberGroupBuffers buffers[MAX_ACTIVE_NUMBERS];
+	static unsigned active;
+	if (active == MAX_ACTIVE_NUMBERS) {
+		ph_out[0] = 0;
+		return 0;
+	}
+	int result = LookupNum3WithBuffers(tr, value, ph_out, suppress_null, thousandplex, control, &buffers[active++]);
+	--active;
+	return result;
+}
